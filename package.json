{
  "name": "my-weather-app",
  "homepage": "https://zkm.github.io/my-weather-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-scripts": "^5.0.1",
    "react-sparklines": "^1.7.0",
    "redux": "^5.0.1",
    "redux-promise": "^0.6.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "NODE_NO_WARNINGS=1 react-scripts build",
    "test": "react-scripts test",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"public/**/*.{html,json}\" \"*.{json,md}\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "nth-check": ">=2.0.1",
    "webpack-dev-server": "^4.15.2",
    "postcss": ">=8.4.31"
  }
}
